<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shifter stays dark regardless of the device's light/dark setting. -->
    <style name="ShifterTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="LaunchTheme" parent="ShifterTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="ShifterTheme">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
